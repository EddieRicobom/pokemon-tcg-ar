{
  "name": "pokemon-tcg-ar",
  "version": "0.1.0",
  "private": true,
  "description": "PWA móvel que reconhece cartas físicas de Pokémon TCG e mostra o GIF animado do Pokémon Showdown em pé sobre a carta, em realidade aumentada.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:assets": "node scripts/copy-ocr-assets.mjs",
    "build:index": "node scripts/build-catalog-index.ts public/data/catalog-index.json",
    "build:art-index": "tsx scripts/build-art-index.ts",
    "sync:sprites": "tsx scripts/sync-pokeapi-sprites.ts",
    "verify:sprite-pack": "tsx scripts/sync-pokeapi-sprites.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "idb": "^8.0.4",
    "mind-ar": "^1.2.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
