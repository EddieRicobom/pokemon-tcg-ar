{
  "name": "pokemon-tcg-ar",
  "version": "0.1.0",
  "private": true,
  "description": "PWA móvel que reconhece cartas físicas de Pokémon TCG e mostra o GIF animado do Pokémon Showdown em pé sobre a carta, em realidade aumentada.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "three": "^0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
